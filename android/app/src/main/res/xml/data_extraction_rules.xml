<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer; same as backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="voice_notes.db"/>
        <include domain="sharedpref" path="FlutterSharedPreferences.xml"/>
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="voice_notes.db"/>
        <include domain="sharedpref" path="FlutterSharedPreferences.xml"/>
    </device-transfer>
</data-extraction-rules>
